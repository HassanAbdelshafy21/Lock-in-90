rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each person can read and write only their own data.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Friends board: knowing a group's 6-character code is what lets you see it.
    // Groups can be fetched by code but never listed; each member can only write their own summary.
    match /groups/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      match /members/{member} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == member;
        // cheers: any signed-in friend can send one; only the person it's for can read and clear them
        match /cheers/{cid} {
          allow create: if request.auth != null && request.resource.data.from == request.auth.uid;
          allow read, delete: if request.auth != null && request.auth.uid == member;
        }
      }
    }
    // Strava tokens live in /private and are reachable only by the cloud job (admin access), never by the app.
  }
}
